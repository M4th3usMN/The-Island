{
  // Configuração do Cloudflare para A Grande Ilha.
  // "name" precisa ser igual ao nome do Worker no painel (the-island).
  "name": "the-island",
  "main": "worker.js",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      { "name": "PLATEIA", "class_name": "Plateia" },
      { "name": "VILA", "class_name": "Vila" }
    ]
  },
  // a cada 5 minutos o servidor confere os comentários do Instagram (código automático no direct)
  // cron das mensagens automáticas do Instagram pausado em 07/11/2026 (restrição da Meta)
  "triggers": { "crons": [] },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Plateia"] },
    { "tag": "v2", "new_sqlite_classes": ["Vila"] }
  ]
}
